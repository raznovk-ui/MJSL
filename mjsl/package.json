{
  "name": "mjsl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MJSL: accessibility of every zone (IRIS) of Marseille, scored from open data",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:noise": "node scripts/fetchNoise.mjs",
    "data:amp": "node scripts/fetchAmp.mjs",
    "data:zones": "node scripts/fetchAmp.mjs && node scripts/clipZones.mjs",
    "data:reports": "node scripts/prepareReports.mjs",
    "data:osm": "vite-node scripts/fetchOsm.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.67.0",
    "maplibre-gl": "^6.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
